# Environment Configuration for Educational Gaming Platform (Virtual Currency Only)

# Node Environment
NODE_ENV=development

# Backend Service
PORT=4000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Connection String (used by Prisma and Fraud Job)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gaming_simulation?schema=public

# Redis Connection (used for Rate Limiting and Session Caching)
REDIS_URL=redis://localhost:6379

# Cryptographic & Token Secrets (Minimum 32 bytes)
JWT_SECRET=educational_simulation_jwt_secret_key_32bytes_min!
JWT_REFRESH_SECRET=educational_simulation_refresh_secret_key_32bytes!
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7

# Concurrency & Row Locking Test Flag (Test mode only)
ROW_LOCKING_ENABLED=true

# Frontend Service
NEXT_PUBLIC_API_URL=http://localhost:4000

